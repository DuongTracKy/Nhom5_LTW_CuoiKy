import { useMemo, useState, type FormEvent } from "react";
import { Modal } from "./AdminLayout";
import {
  formatDate,
  MOVIE_STATUSES,
  useMovies,
  useShowtimes,
  type Movie,
  type MovieStatus,
} from "./adminStore";

const STATUS_LABEL: Record<MovieStatus, string> = {
  showing: "Đang chiếu",
  coming: "Sắp chiếu",
  ended: "Đã kết thúc",
};

interface MovieForm {
  title: string;
  genre: string;
  duration: string;
  releaseDate: string;
  status: MovieStatus;
  poster: string;
  description: string;
}

const EMPTY_FORM: MovieForm = {
  title: "",
  genre: "",
  duration: "",
  releaseDate: "",
  status: "showing",
  poster: "",
  description: "",
};

export default function ManageMovies() {
  const { items: movies, add, update, remove } = useMovies();
  const { items: showtimes } = useShowtimes();

  const [query, setQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState<MovieStatus | "all">("all");
  const [isOpen, setIsOpen] = useState(false);
  const [editingId, setEditingId] = useState<string | null>(null);
  const [form, setForm] = useState<MovieForm>(EMPTY_FORM);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  const filtered = useMemo(() => {
    const keyword = query.trim().toLowerCase();
    return movies.filter(
      (m) =>
        (statusFilter === "all" || m.status === statusFilter) &&
        (!keyword || m.title.toLowerCase().includes(keyword)),
    );
  }, [movies, query, statusFilter]);

  const setField = <K extends keyof MovieForm>(key: K, value: MovieForm[K]) =>
    setForm((prev) => ({ ...prev, [key]: value }));

  const openCreate = () => {
    setEditingId(null);
    setForm(EMPTY_FORM);
    setError("");
    setIsOpen(true);
  };

  const openEdit = (movie: Movie) => {
    setEditingId(movie.id);
    setForm({
      title: movie.title,
      genre: movie.genre,
      duration: String(movie.duration),
      releaseDate: movie.releaseDate,
      status: movie.status,
      poster: movie.poster,
      description: movie.description,
    });
    setError("");
    setIsOpen(true);
  };

  const closeModal = () => setIsOpen(false);

  const handleSubmit = (e: FormEvent) => {
    e.preventDefault();

    const title = form.title.trim();
    const duration = Number(form.duration);

    if (!title) return setError("Vui lòng nhập tên phim.");
    if (!Number.isInteger(duration) || duration <= 0 || duration > 600) {
      return setError("Thời lượng phải là số phút từ 1 đến 600.");
    }
    if (!form.releaseDate) return setError("Vui lòng chọn ngày khởi chiếu.");

    const payload = {
      title,
      genre: form.genre.trim(),
      duration,
      releaseDate: form.releaseDate,
      status: form.status,
      poster: form.poster.trim(),
      description: form.description.trim(),
    };

    if (editingId) update(editingId, payload);
    else add(payload);

    setNotice("");
    closeModal();
  };

  const handleDelete = (movie: Movie) => {
    if (showtimes.some((s) => s.movieId === movie.id)) {
      setNotice(`Không thể xóa "${movie.title}" vì phim đang có suất chiếu. Hãy xóa suất chiếu trước.`);
      return;
    }
    if (window.confirm(`Xóa phim "${movie.title}"?`)) {
      remove(movie.id);
      setNotice("");
    }
  };

  return (
    <>
      <div className="adm-head">
        <div>
          <h1>Quản lý phim</h1>
          <p className="adm-sub">{movies.length} phim trong hệ thống</p>
        </div>
        <button type="button" className="adm-btn primary" onClick={openCreate}>
          Thêm phim
        </button>
      </div>

      {notice && (
        <div className="adm-notice" role="alert">
          <span>{notice}</span>
          <button type="button" className="adm-icon-btn" onClick={() => setNotice("")} aria-label="Ẩn thông báo">
            ×
          </button>
        </div>
      )}

      <div className="adm-toolbar">
        <input
          className="adm-input"
          type="search"
          placeholder="Tìm theo tên phim"
          aria-label="Tìm theo tên phim"
          value={query}
          onChange={(e) => setQuery(e.target.value)}
        />
        <select
          className="adm-select"
          aria-label="Lọc theo trạng thái"
          value={statusFilter}
          onChange={(e) => setStatusFilter(e.target.value as MovieStatus | "all")}
        >
          <option value="all">Tất cả trạng thái</option>
          {MOVIE_STATUSES.map((s) => (
            <option key={s} value={s}>
              {STATUS_LABEL[s]}
            </option>
          ))}
        </select>
      </div>

      <div className="adm-card">
        {filtered.length === 0 ? (
          <p className="adm-empty">
            {movies.length === 0 ? "Chưa có phim nào. Bấm \"Thêm phim\" để bắt đầu." : "Không tìm thấy phim phù hợp."}
          </p>
        ) : (
          <div className="adm-table-wrap">
            <table className="adm-table">
              <thead>
                <tr>
                  <th>Phim</th>
                  <th>Thể loại</th>
                  <th className="num">Thời lượng</th>
                  <th>Khởi chiếu</th>
                  <th>Trạng thái</th>
                  <th />
                </tr>
              </thead>
              <tbody>
                {filtered.map((movie) => (
                  <tr key={movie.id}>
                    <td>
                      <div className="adm-movie-cell">
                        {movie.poster ? (
                          <img className="adm-thumb" src={movie.poster} alt="" loading="lazy" />
                        ) : (
                          <span className="adm-thumb" aria-hidden="true" />
                        )}
                        <strong>{movie.title}</strong>
                      </div>
                    </td>
                    <td>{movie.genre || "—"}</td>
                    <td className="num">{movie.duration} phút</td>
                    <td>{formatDate(movie.releaseDate)}</td>
                    <td>
                      <span className={`adm-badge ${movie.status}`}>{STATUS_LABEL[movie.status]}</span>
                    </td>
                    <td>
                      <div className="adm-actions">
                        <button type="button" className="adm-btn small" onClick={() => openEdit(movie)}>
                          Sửa
                        </button>
                        <button type="button" className="adm-btn small danger" onClick={() => handleDelete(movie)}>
                          Xóa
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {isOpen && (
        <Modal title={editingId ? "Sửa phim" : "Thêm phim"} onClose={closeModal}>
          <form className="adm-form" onSubmit={handleSubmit} noValidate>
            <div className="adm-field full">
              <label htmlFor="movie-title">Tên phim</label>
              <input
                id="movie-title"
                className="adm-input"
                value={form.title}
                onChange={(e) => setField("title", e.target.value)}
                autoFocus
              />
            </div>
            <div className="adm-field">
              <label htmlFor="movie-genre">Thể loại</label>
              <input
                id="movie-genre"
                className="adm-input"
                value={form.genre}
                onChange={(e) => setField("genre", e.target.value)}
              />
            </div>
            <div className="adm-field">
              <label htmlFor="movie-duration">Thời lượng (phút)</label>
              <input
                id="movie-duration"
                className="adm-input"
                type="number"
                min={1}
                max={600}
                value={form.duration}
                onChange={(e) => setField("duration", e.target.value)}
              />
            </div>
            <div className="adm-field">
              <label htmlFor="movie-release">Ngày khởi chiếu</label>
              <input
                id="movie-release"
                className="adm-input"
                type="date"
                value={form.releaseDate}
                onChange={(e) => setField("releaseDate", e.target.value)}
              />
            </div>
            <div className="adm-field">
              <label htmlFor="movie-status">Trạng thái</label>
              <select
                id="movie-status"
                className="adm-select"
                value={form.status}
                onChange={(e) => setField("status", e.target.value as MovieStatus)}
              >
                {MOVIE_STATUSES.map((s) => (
                  <option key={s} value={s}>
                    {STATUS_LABEL[s]}
                  </option>
                ))}
              </select>
            </div>
            <div className="adm-field full">
              <label htmlFor="movie-poster">Link ảnh poster</label>
              <input
                id="movie-poster"
                className="adm-input"
                type="url"
                placeholder="https://..."
                value={form.poster}
                onChange={(e) => setField("poster", e.target.value)}
              />
            </div>
            <div className="adm-field full">
              <label htmlFor="movie-desc">Mô tả</label>
              <textarea
                id="movie-desc"
                className="adm-textarea"
                value={form.description}
                onChange={(e) => setField("description", e.target.value)}
              />
            </div>

            {error && (
              <p className="adm-error" role="alert">
                {error}
              </p>
            )}

            <div className="adm-form-actions">
              <button type="button" className="adm-btn" onClick={closeModal}>
                Hủy
              </button>
              <button type="submit" className="adm-btn primary">
                {editingId ? "Lưu thay đổi" : "Thêm phim"}
              </button>
            </div>
          </form>
        </Modal>
      )}
    </>
  );
}